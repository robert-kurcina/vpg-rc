{
  "schemaVersion": 1,
  "contract": "universal-scenario-domains-v1",
  "policy": {
    "oneEngine": true,
    "onePresentationFramework": true,
    "defaultInheritance": "forbidden",
    "typedModulesOnly": true,
    "noUnverifiedExecutableActivation": true,
    "originalB4MAuthority": "Oberlabs-compatible runtime remains unchanged during migration"
  },
  "domains": {
    "players": "Player factions and turn order",
    "phases": "Ordered phases, permissions and extra phases",
    "roster": "Counter identities, sides and strengths",
    "deployment": "Starting hexes, regions and reinforcements",
    "victory": "Victory points, objectives, end checks and tie-breaks",
    "map": "Hex geometry, layers and features",
    "weather": "Weather schedules, effects and transition rules",
    "terrain": "Movement and combat terrain effects",
    "crt": "Combat result table, odds, shifts and roll policy",
    "microrules": "Typed optional named rule modules",
    "soloAI": "Available AI policies and permitted actions",
    "presentation": "Player UX, legal action selection, rules tabs",
    "turns": "Turn calendar and game length",
    "logistics": "Supply, replacement and special logistics"
  },
